{
  "name": "medusa-server",
  "version": "1.0.0",
  "description": "MedusaJS backend server for multi-vendor ecommerce platform",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "node -e \"console.log('No Medusa seed configured for custom API')\"",
    "migration": "node -e \"console.log('Use SQL migrations for custom API')\"",
    "migration:generate": "node -e \"console.log('Use SQL migrations for custom API')\"",
    "typeorm": "typeorm"
  },
  "dependencies": {
    "@medusajs/cache-inmemory": "^2.13.5",
    "@medusajs/event-bus-local": "^2.13.5",
    "@medusajs/medusa": "^1.20.6",
    "@medusajs/medusa-cli": "^1.3.22",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.4",
    "cloudinary": "^2.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "medusa-file-cloudinary": "^1.0.0",
    "medusa-fulfillment-manual": "^1.1.40",
    "medusa-payment-manual": "^1.0.24",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "razorpay": "^2.9.2",
    "redis": "^4.6.13",
    "serverless-http": "^4.0.0",
    "typeorm": "^0.3.17",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.20",
    "babel-cli": "^6.26.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  }
}
